ir_version = "0.1"

graph context.embedding_probe {
    inputs = { request = json }
    outputs = { response = json }
    nodes {
        embed = call(mcp.tool("llm", "embed"))
        result = eval(json, inputs.response.data) { inputs = { response = McpToolResult } }
    }
    edges {
        edge request { from = inputs.request to = embed.inputs.arguments }
        edge data { from = embed.outputs.value to = result.inputs.response }
        edge response { from = result.outputs.value to = outputs.response }
    }
    limits { max_mcp_calls = 1 }
}
