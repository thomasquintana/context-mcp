ir_version = "0.1"

-- Provider-native argument construction belongs in operator configuration/graphs.
graph context.model_media {
    inputs = { generation = json, embedding = json, transcription = json }
    outputs = { generated = json, embedded = json, transcribed = json }
    nodes {
        generate = call(mcp.tool("llm", "generate"))
        embed = call(mcp.tool("llm", "embed"))
        transcribe = call(mcp.tool("llm", "transcribe"))
        generated = eval(json, inputs.response.data) { inputs = { response = McpToolResult } }
        embedded = eval(json, inputs.response.data) { inputs = { response = McpToolResult } }
        transcribed = eval(json, inputs.response.data) { inputs = { response = McpToolResult } }
    }
    edges {
        edge generation { from = inputs.generation to = generate.inputs.arguments }
        edge embedding { from = inputs.embedding to = embed.inputs.arguments }
        edge transcription { from = inputs.transcription to = transcribe.inputs.arguments }
        edge generation_data { from = generate.outputs.value to = generated.inputs.response }
        edge embedding_data { from = embed.outputs.value to = embedded.inputs.response }
        edge transcription_data { from = transcribe.outputs.value to = transcribed.inputs.response }
        edge generated { from = generated.outputs.value to = outputs.generated }
        edge embedded { from = embedded.outputs.value to = outputs.embedded }
        edge transcribed { from = transcribed.outputs.value to = outputs.transcribed }
    }
    limits { max_mcp_calls = 3 }
}
