{
  "bind":"127.0.0.1:8089",
  "public_url":"http://localhost:8089/mcp",
  "allowed_hosts":["localhost","127.0.0.1","::1"],
  "allowed_origins":["http://localhost:8089"],
  "stdio_token_env":"CONTEXT_STDIO_TOKEN",
  "max_request_bytes":1048576,
  "request_timeout_ms":180000,
  "application":{
    "database_url_env":"CONTEXT_DATABASE_URL",
    "database_connections":8,
    "oidc":{
      "issuer":"http://127.0.0.1:58080/realms/context-dev",
      "audience":"http://localhost:8089/mcp",
      "scope_map":{
        "context:read":"read","context:ingest":"ingest","context:memory:write":"write_memory",
        "context:synthesize":"synthesize","context:share":"share","context:purge":"purge"
      },
      "required_claims":{"typ":"Bearer"},
      "verification":{"mode":"jwks"},
      "allow_http":true
    },
    "workflows":{
      "database":"../../data/runtime.sqlite",
      "roles":{
        "extract":{"source":"extract.htlk","catalogs":"../../target/providers/catalogs.json","checkpoints":["create"]},
        "cleanup":{"source":"cleanup.htlk","catalogs":"../../target/providers/catalogs.json"},
        "enrich":{"source":"enrich.htlk","catalogs":"../../target/providers/catalogs.json"},
        "describe":{"source":"describe.htlk","catalogs":"../../target/providers/catalogs.json"},
        "transcribe":{"source":"transcribe.htlk","catalogs":"../../target/providers/catalogs.json"},
        "embed":{"source":"embed.htlk","catalogs":"../../target/providers/catalogs.json"},
        "sandbox.metadata":{"source":"sandbox-metadata.htlk","catalogs":"../../target/providers/catalogs.json"}
      },
      "required_deployments":["initial-model-provider","initial-sandbox-provider"],
      "workers":2,"max_runs":64,
      "endpoints":{
        "initial-model-provider":{
          "transport":"stdio","program":"../llm-mcp/target/debug/llm-mcp","arguments":["serve"],
          "environment":{"LLM_MCP_AUTH":"api_key","LLM_MCP_TRANSPORT":"stdio"},"inherit_environment":["OPENAI_API_KEY"]
        },
        "initial-sandbox-provider":{
          "transport":"stdio","program":"target/providers/mcp-sandbox","arguments":[],"environment":{},
          "inherit_environment":["ALLOW_DIRS","SANDBOX_PROFILES_DIR","DOCKER_HOST"]
        }
      }
    },
    "data":{
      "s3_endpoint":"http://127.0.0.1:59000","s3_bucket":"context","s3_region":"us-east-1",
      "s3_access_key_env":"CONTEXT_S3_ACCESS_KEY","s3_secret_key_env":"CONTEXT_S3_SECRET_KEY","s3_allow_http":true,
      "typesense_endpoint":"http://127.0.0.1:58108","typesense_key_env":"CONTEXT_TYPESENSE_KEY",
      "spaces":{"text-embedding-3-small:256:v1":{"collection":"context_v1","dimensions":256,"document_role":"embed","query_role":"embed"}},
      "default_space":"text-embedding-3-small:256:v1","default_profile":"multimodal",
      "profiles":{"multimodal":{
        "media_types":["text/*","application/javascript","application/typescript","application/x-python","application/x-sh","application/xml","application/sql","application/json","application/pdf","application/epub+zip","application/zip","application/x-tar","application/gzip","application/x-gzip",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.openxmlformats-officedocument.presentationml.presentation",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","image/*","audio/*","video/*"],
        "extract_role":"extract","cleanup_role":"cleanup","cleanup_node":"create","describe_role":"describe","transcribe_role":"transcribe","enrich_role":"enrich",
        "space":"text-embedding-3-small:256:v1","chunk_bytes":4096}},
      "staging_directory":"../../data/staging","max_upload_bytes":1073741824,"upload_lifetime_seconds":900,"max_pending_jobs":1024,"workers":2,"max_segments":1000
    }
  }
}
